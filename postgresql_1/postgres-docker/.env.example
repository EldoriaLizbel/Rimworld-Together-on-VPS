# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# pin เวอร์ชันชัดเจน ห้ามใช้ latest
POSTGRES_VERSION=16.4
POSTGRES_USER=app_user
# สุ่มรหัสผ่านอย่างน้อย 24 ตัวอักษร เช่น:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_PASSWORD=change_me_to_a_strong_random_password_24plus
POSTGRES_DB=app_db
TZ=Asia/Bangkok

# Local nonprod bootstrap. Match the DB password used in frontend_1/.env.
RIMWORLD_ADMIN_PASSWORD=replace_me
RIMWORLD_WEB_DB_PASSWORD=replace_me
