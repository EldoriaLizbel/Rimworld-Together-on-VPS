RIMWORLD_API_DB_PASSWORD=
RIMWORLD_API_TOKEN=
# Set this to the POSTGRES_DB value in postgresql_1/postgres-docker/.env.
RIMWORLD_API_DB_NAME=app_db
# Local nonprod defaults.
RIMWORLD_HOST_BIND=127.0.0.1
RIMWORLD_HOST_PORT=25555
RIMWORLD_PUBLIC_HOST=
RIMWORLD_WEB_BIND=127.0.0.1
RIMWORLD_WEB_PORT=10005
BEEKEEPER_WEB_PORT=5800
# The scripts enable Beekeeper unless set to 0. It is always bound to loopback.
RWT_BEEKEEPER_ENABLED=1
# Optional Compose resource limits (0 = unlimited).
RWT_WEB_MEMORY=0
RWT_API_MEMORY=0
RWT_POSTGRES_MEMORY=0
RWT_GAME_MEMORY=0
RWT_GAME_CPUS=0
# Bootstrap writes the managed state, data, and env paths automatically.
# RWT_GAME_DATA=./.rwt-deploy/game
# RWT_WEB_ENV_FILE=./.rwt-deploy/web.env
# RWT_POSTGRES_ENV_FILE=./.rwt-deploy/postgres.env
# RWT_BACKUP_DIR=/mnt/private-backups/rimworld
RWT_BACKUP_MAX_COUNT=14
RWT_BACKUP_MAX_DAYS=30
RWT_BACKUP_MIN_KEEP=3
