# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# เชื่อม postgres ผ่าน docker network app_network (hostname = ชื่อ service "postgres")
# role rimworld_web สร้างด้วย postgresql_1/postgres-docker/sql/003_app_role.sql
DATABASE_URL=postgresql://rimworld_web:change_me@postgres:5432/app_db
# ใช้ sign session cookie (>= 32 ตัวอักษร) เช่น: openssl rand -base64 64 | tr -dc 'A-Za-z0-9' | head -c 64
SESSION_SECRET=change_me_to_a_random_string_of_at_least_32_chars
# true เมื่อเปิดผ่าน HTTPS
COOKIE_SECURE=false
